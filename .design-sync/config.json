{
  "projectId": "2b356bc9-6280-4700-96da-482f21fb83ea",
  "shape": "package",
  "pkg": "app-comi",
  "globalName": "AppComi",
  "srcDir": "src",
  "tsconfig": ".design-sync/tsconfig.sync.json",
  "buildCmd": "node .design-sync/build-css.mjs",
  "cssEntry": ".design-sync/.cache/ds.css",
  "extraFonts": [".design-sync/.cache/archivo-alias.css"],
  "tokensGlob": ["src/styles/tokens.css", "src/styles/theme.css"],
  "docsDir": ".design-sync/docs",
  "readmeHeader": ".design-sync/conventions.md",
  "provider": { "component": "DesignPreviewProviders" },
  "libOverrides": {
    "source-kit.mjs": "app repo, not a component library: src paths are feature folders, so grouping comes from .design-sync/docs frontmatter"
  },
  "overrides": {
    "Avatar": { "cardMode": "column" },
    "ButtonGroup": { "cardMode": "column" },
    "CarDrawing": { "cardMode": "column" },
    "Cover": { "cardMode": "column" },
    "ExitPhotoCard": { "cardMode": "column" },
    "Fact": { "cardMode": "column" },
    "FieldShell": { "cardMode": "column" },
    "GoogleButton": { "cardMode": "column" },
    "JuntaHeader": { "cardMode": "column" },
    "Places": { "cardMode": "column" },
    "ShareCard": { "cardMode": "column" },
    "TabBar": { "cardMode": "single", "primaryStory": "Default" },
    "TextField": { "cardMode": "column" },
    "Wordmark": { "cardMode": "column" }
  },
  "componentSrcMap": {
    "Avatar": "src/ui/Avatar/Avatar.tsx",
    "Button": "src/ui/Button/Button.tsx",
    "ButtonGroup": "src/ui/Button/Button.tsx",
    "FieldShell": "src/ui/Field/Field.tsx",
    "TextField": "src/ui/Field/Field.tsx",
    "LogoMark": "src/ui/Logo/Logo.tsx",
    "Wordmark": "src/ui/Logo/Logo.tsx",
    "TabBar": "src/ui/TabBar/TabBar.tsx",
    "HomeIcon": "src/ui/TabBar/icons.tsx",
    "RankingIcon": "src/ui/TabBar/icons.tsx",
    "QrIcon": "src/ui/TabBar/icons.tsx",
    "ProposalsIcon": "src/ui/TabBar/icons.tsx",
    "ProfileIcon": "src/ui/TabBar/icons.tsx",
    "GoogleButton": "src/features/entry/GoogleButton.tsx",
    "Cover": "src/features/event/detail.tsx",
    "Fact": "src/features/event/detail.tsx",
    "Places": "src/features/event/detail.tsx",
    "JuntaHeader": "src/features/junta/JuntaHeader.tsx",
    "ExitPhotoCard": "src/features/photos/ExitPhotoCard.tsx",
    "CarDrawing": "src/features/rides/CarDrawing.tsx",
    "ShareCard": "src/features/share/ShareCard.tsx"
  }
}
