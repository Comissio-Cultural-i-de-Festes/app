# Copy to .env and fill in. Never commit .env.
# Everything here is inlined into the browser bundle at build time.
# None of it is secret — the anon key is public by design and RLS is the
# only security boundary.

# Association identity. Nothing about the app is hardcoded to one association;
# fork it, change these and the BRAND block in src/styles/tokens.css.
VITE_APP_NAME=
# The wordmark and the app icon are drawn from this, and a full stop at the
# end is set as a coloured disc rather than a glyph — "comi." draws the dot,
# "La Comi" simply does not. It is also the manifest short_name, so it is what
# appears under the icon on a phone: keep it short.
VITE_APP_SHORT_NAME=
VITE_APP_DESCRIPTION=
# Shown under the wordmark on the entry screen, e.g. the campus and town.
VITE_APP_TAGLINE=
# Invite link to the association's WhatsApp group, for "ask for one there".
VITE_WHATSAPP_URL=

# PWA manifest colours. Hex only — Android's splash generator does not parse
# oklch(). Match --ds-bg-app in src/styles/tokens.css.
# QUOTE THEM. dotenv reads an unquoted leading # as a comment and hands Vite
# an empty string, so the manifest silently ships with no theme colour.
#   VITE_THEME_COLOR="#100909"
VITE_THEME_COLOR=
VITE_BACKGROUND_COLOR=

# ca | es | en
VITE_DEFAULT_LOCALE=
# IANA zone used for every date the app formats, e.g. Europe/Madrid
VITE_TIME_ZONE=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sign-in method.
#
# Entry is Sign in with Google. There is no association domain, so there is no
# verified sender and no real email can be sent — the built-in SMTP allows two
# messages an hour and the first event is a hundred sign-ups in an evening.
#
# Set to true to bring the email path back alongside it: same screen, same
# invitation gate, plus a six-digit code in the email. Needed if a domain is
# ever bought, and needed sooner if the Google round trip turns out not to
# return to an installed app on iOS. See "Checking the iPhone round trip" in
# the README.
VITE_AUTH_EMAIL_FALLBACK=

# Entry photographs at the door.
#
# Leave empty. The prototype takes one automatically on a valid scan and the
# machinery is all here — a private bucket, signed URLs that expire, only the
# junta can read them — but the notice telling people it happens has not been
# written. Set to true once it has.
VITE_ENTRY_PHOTO=

# Google OAuth, LOCAL DEVELOPMENT ONLY. The hosted project takes these from the
# Supabase dashboard, not from here.
#
# Create a separate OAuth client for local work rather than reusing the real
# one, with http://127.0.0.1:54321/auth/v1/callback as the redirect URI.
#
# Careful: if these are unset, the CLI does not substitute and passes the
# literal string "env(GOOGLE_OAUTH_CLIENT_ID)" through to Google, which then
# shows an error page about an invalid client. That is what a missing value
# looks like.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
